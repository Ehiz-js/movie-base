# ---- TMDB -------------------------------------------------------------------
# Server-side only. Deliberately NOT prefixed with NEXT_PUBLIC_, which would
# inline the key into the browser bundle. Get one at:
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ---- Supabase ---------------------------------------------------------------
# Dashboard -> Project Settings -> API. The anon/publishable key is safe to
# expose only because row level security is enabled (see supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# ---- Watchlist email (Resend) ---------------------------

RESEND_API_KEY=